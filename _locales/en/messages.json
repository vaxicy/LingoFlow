  "guide_nim_desc": {
    "message": "NVIDIA NIM provides 57+ free inference endpoints with an OpenAI-compatible API, covering many open-source models.",
    "description": "NVIDIA NIM setup guide description"
  },
  "guide_nim_s1": {
    "message": "Visit build.nvidia.com, sign up or sign in with an NVIDIA account (supports Google / GitHub sign-in)",
    "description": "NVIDIA NIM step 1"
  },
  "guide_nim_s2": {
    "message": "Go to the <code>Models</code> page, filter <code>Free Endpoint</code>, and click into any free model you want to use",
    "description": "NVIDIA NIM step 2"
  },
  "guide_nim_s3": {
    "message": "On the model detail page, click <strong>Generate API Key</strong> in the top-right corner of the code sample area and copy the key (only shown once)",
    "description": "NVIDIA NIM step 3"
  },
  "guide_nim_s4": {
    "message": "In the same code sample, find the <strong>Base URL</strong> (usually <code>https://integrate.api.nvidia.com/v1</code>) and the <strong>model name</strong> (e.g. <code>z-ai/glm-5.2</code>)",
    "description": "NVIDIA NIM step 4"
  },
  "guide_nim_s5": {
    "message": "Back in LingoFlow settings, choose \"Custom (OpenAI Compatible)\" and fill in Host / API Key / Model",
    "description": "NVIDIA NIM step 5"
  },
  "guide_go_nim": {
    "message": "Go to NVIDIA NIM to get a free endpoint",
    "description": "NVIDIA NIM CTA"
  },
