  "guide_bailian_desc": {
    "message": "Alibaba Cloud Bailian (Qwen) offers an OpenAI-compatible API with a free quota and fast speed.",
    "description": "Alibaba Bailian setup guide description"
  },
  "guide_bailian_s1": {
    "message": "Visit the Alibaba Cloud Bailian console and sign in with your Alibaba Cloud account",
    "description": "Alibaba Bailian step 1"
  },
  "guide_bailian_s2": {
    "message": "Go to \"API-KEY Management\" and click \"Create new API-KEY\"",
    "description": "Alibaba Bailian step 2"
  },
  "guide_bailian_s3": {
    "message": "Copy the API Key that starts with <code>sk-</code>",
    "description": "Alibaba Bailian step 3"
  },
  "guide_bailian_s4": {
    "message": "In LingoFlow settings, choose \"Alibaba Bailian\", paste the key and pick a model. For a dedicated workspace, fill in the console address in the Host field",
    "description": "Alibaba Bailian step 4"
  },
  "guide_go_bailian": {
    "message": "Go to Alibaba Bailian to get an API Key",
    "description": "Alibaba Bailian CTA"
  },
  "guide_siliconflow_desc": {
    "message": "AI translation with multiple open-source models. Free models need no payment.",
    "description": "SiliconFlow setup guide description"
  },
  "guide_siliconflow_s1": {
    "message": "Visit the SiliconFlow website, sign up and sign in",
    "description": "SiliconFlow step 1"
  },
  "guide_siliconflow_s2": {
    "message": "Go to \"API Key Management\" and click \"Create new key\"",
